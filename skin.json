{
    "name": "Phosphor",
    "author": "OriginalSwayze",
    "description": "Steam as a tiling terminal on a phosphor CRT: two panes with box-drawing borders, a tmux-style status line holding the tabs, dock and clock, reverse-video selection, monochrome images, a power-on self test, and a real command line (press \":\").",
    "version": "1.0.0",
    "tags": [
        "Terminal",
        "Monospace",
        "CRT",
        "Retro",
        "Minimal"
    ],
    "header_image": "https://raw.githubusercontent.com/OriginalSwayze/Phosphor/main/media/library.gif",
    "splash_image": "https://raw.githubusercontent.com/OriginalSwayze/Phosphor/main/media/gamepage.png",
    "github": {
        "owner": "OriginalSwayze",
        "repo_name": "Phosphor"
    },
    "Steam-WebKit": "webkit.css",
    "Conditions": {
        "Phosphor": {
            "description": "P1 green, P3 amber, P4 white, Ice blue or Rose.",
            "tab": "Look",
            "default": "Green",
            "values": {
                "Green": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/presets/green.css"
                    }
                },
                "Amber": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/presets/amber.css"
                    }
                },
                "White": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/presets/white.css"
                    }
                },
                "Ice": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/presets/ice.css"
                    }
                },
                "Rose": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/presets/rose.css"
                    }
                }
            }
        },
        "Images": {
            "description": "Show covers and art in phosphor monochrome, or in color.",
            "tab": "Look",
            "default": "Monochrome",
            "values": {
                "Monochrome": {},
                "Color": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/images-color.css"
                    }
                }
            }
        },
        "Scanlines": {
            "description": "CRT scanlines, the roll bar and the curved-glass vignette.",
            "tab": "Look",
            "default": "Normal",
            "values": {
                "Normal": {},
                "Heavy": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/scan-heavy.css"
                    }
                },
                "Off": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/scan-off.css"
                    }
                }
            }
        },
        "Game list density": {
            "description": "Row size in the game list.",
            "tab": "Layout",
            "default": "Comfortable",
            "values": {
                "Comfortable": {},
                "Compact": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/list-compact.css"
                    }
                }
            }
        },
        "What's New shelf": {
            "description": "The What's New carousel on the library home.",
            "tab": "Layout",
            "default": "Show",
            "values": {
                "Show": {},
                "Hide": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/hide-whats-new.css"
                    }
                }
            }
        },
        "Readout": {
            "description": "Uptime, date and clock on the right of the status line.",
            "tab": "Layout",
            "default": "On",
            "values": {
                "On": {},
                "Off": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/hud-off.css"
                    }
                }
            }
        },
        "Startup screen": {
            "description": "The power-on self test when Steam opens.",
            "tab": "Motion",
            "default": "On",
            "values": {
                "On": {},
                "Off": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/boot-off.css"
                    }
                }
            }
        },
        "Motion": {
            "description": "Full: everything. Calm: hovers only, the backdrop stands still. Still: no theme motion.",
            "tab": "Motion",
            "default": "Full",
            "values": {
                "Full": {},
                "Calm": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/motion-calm.css"
                    }
                },
                "Still": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/motion-still.css"
                    }
                }
            }
        },
        "Privacy": {
            "description": "Blur your account name and wallet until hovered.",
            "tab": "Extras",
            "default": "Off",
            "values": {
                "Off": {},
                "Blur": {
                    "TargetCss": {
                        "affects": [
                            "^Steam$"
                        ],
                        "src": "options/privacy.css"
                    }
                }
            }
        },
        "Contrast": {
            "description": "High: solid panels and brighter secondary text.",
            "tab": "Accessibility",
            "default": "Normal",
            "values": {
                "Normal": {},
                "High": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/contrast-high.css"
                    }
                }
            }
        },
        "Focus rings": {
            "description": "Strong: a thick, high-visibility outline on whatever has keyboard or controller focus.",
            "tab": "Accessibility",
            "default": "Standard",
            "values": {
                "Standard": {},
                "Strong": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/focus-strong.css"
                    }
                }
            }
        },
        "Text size": {
            "description": "Large: bigger game list and body text.",
            "tab": "Accessibility",
            "default": "Normal",
            "values": {
                "Normal": {},
                "Large": {
                    "TargetCss": {
                        "affects": [
                            ".*"
                        ],
                        "src": "options/text-large.css"
                    }
                }
            }
        }
    },
    "Patches": [
        {
            "MatchRegexString": "^Steam$",
            "TargetCss": "main.css",
            "TargetJs": "js/main.js"
        },
        {
            "MatchRegexString": ".ModalDialogPopup",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".FullModalOverlay",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".friendsui-container",
            "TargetCss": "friends.css"
        },
        {
            "MatchRegexString": ".ContextMenuPopup",
            "TargetCss": "popup.css"
        },
        {
            "MatchRegexString": ".DesktopToastContainer",
            "TargetCss": "toast.css"
        },
        {
            "MatchRegexString": "^Sign in to Steam$",
            "TargetCss": "login.css"
        }
    ]
}
